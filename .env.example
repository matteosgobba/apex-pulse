# Optional override used when commands are run outside the repository root.
# F1_PREDICTION_PROJECT_ROOT=/absolute/path/to/repository

# FastF1 cache and output paths are configured in configs/data.yaml.

# Local read-only dashboard API example. PORT is intentionally omitted so the
# existing 127.0.0.1:8000 development default remains active.
# APEX_PULSE_DASHBOARD_DIR=reports/dashboard
# APEX_PULSE_DASHBOARD_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# APEX_PULSE_DASHBOARD_STALE_AFTER_MINUTES=180

# Production API example (Railway or an equivalent container platform).
# Mount one persistent volume at APEX_PULSE_RUNTIME_ROOT. The container startup
# links /app/data, /app/reports, and /app/models into this root.
# PORT=8000
# APEX_PULSE_RUNTIME_ROOT=/runtime
# APEX_PULSE_DASHBOARD_DIR=/runtime/reports/dashboard
# APEX_PULSE_DASHBOARD_API_CORS_ORIGINS=https://your-frontend.example.com
# APEX_PULSE_DASHBOARD_STALE_AFTER_MINUTES=180
# APEX_PULSE_AUTOPILOT_ENABLED=false
# APEX_PULSE_AUTOPILOT_SCHEDULER_ENABLED=false
# APEX_PULSE_AUTOPILOT_INTERVAL_SECONDS=300
# APEX_PULSE_AUTOPILOT_INITIAL_DELAY_SECONDS=10
# APEX_PULSE_RUNTIME_CACHE_WARNING_MB=400
# APEX_PULSE_RUNTIME_VOLUME_CAPACITY_MB=500
